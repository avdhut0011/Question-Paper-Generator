# Add these settings to .env while preserving your existing AI key.
DATABASE_URL=postgresql+psycopg://qpg_user:URL_ENCODED_PASSWORD@localhost:5432/ashoka_qpg
FLASK_SECRET_KEY=replace_with_a_unique_random_secret
# true for production HTTPS; false for local HTTP only
QPG_HTTPS=false
QPG_STORAGE_ROOT=instance/private
GEMINI_API_KEY=replace_with_your_key
# Choose a model supported by your account
GEMINI_MODEL=
# true requires pdflatex on the worker PATH; false produces HTML/LaTeX only
QPG_REQUIRE_PDF=true
